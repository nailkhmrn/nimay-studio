# Copy to .env.local (never commit real keys). Set the same values in Vercel > Project > Settings > Environment Variables.

# Contact form: Cloudflare Turnstile. The site key is public, the secret stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form: rate limit (Upstash Redis REST). Leave empty in development to use an in-memory counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random text used to hash IP and email for the rate limit (for example: openssl rand -hex 32).
RATE_LIMIT_SALT=

# Contact form: email delivery (Resend). In development, empty values log the message to the server console instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@nimaystudio.com
CONTACT_FROM_EMAIL=
